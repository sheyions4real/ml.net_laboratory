################################################################################
# ML.NET Master Suite
# Keep: source code, projects, solution, docs, CSV data, folder structure
# Ignore: build output, IDE cache, NuGet packages, trained models
################################################################################

## Visual Studio / JetBrains
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.DotSettings.user

## Build output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Bb]uild/
artifacts/
out/
publish/

## NuGet (restored via dotnet restore — PackageReference in .csproj is still tracked)
packages/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json

## Test & coverage
[Tt]est[Rr]esult*/
TestResults/
coverage/
*.trx
*.coverage
*.coveragexml
*.opencover.xml
.msCoverageSourceRootsMapping_*

## Trained models (generated by your Training console apps)
**/model/*
!**/model/.gitkeep
*.onnx
*.pb
*.mlnet

## Secrets / local overrides
*.env
*.env.*
secrets.json
appsettings.*.local.json

## OS & editors
.DS_Store
Thumbs.db
Desktop.ini
.cursor/
*.swp
*~
*.log
*.tmp

################################################################################
# Tracked by design (not listed above):
#   *.cs, *.csproj, *.sln, *.md, *.ps1, *.csv, *.http
#   appsettings.json, launchSettings.json
#   **/data/**, **/model/.gitkeep
################################################################################
