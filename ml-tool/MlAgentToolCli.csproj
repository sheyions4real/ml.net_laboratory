<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>MlAgentToolCli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	  <!-- Custom settings -->
	  <AssemblyName>ml-agent-tool</AssemblyName>
	  <RootNamespace>MlAgentToolCli</RootNamespace>
	  <Version>1.0</Version>
	  <Authors>Omagene Sheyi Matthew</Authors>
	  <Description>Master Machine learning cli toolset for different preduction</Description>
	  
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="6.0.0-preview.26457.2" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="6.0.0-preview.26457.2" />
    <PackageReference Include="Microsoft.ML.LightGbm" Version="6.0.0-preview.26457.2" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-rc.1.26425.128" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\00-Shared\MLNet.Shared\MLNet.Shared.csproj" />
  </ItemGroup>

	<ItemGroup>
		<!-- This automatically moves the models folder and everything inside it to your bin directory on build -->
		<None Update="MlModels\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
